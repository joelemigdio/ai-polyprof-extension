{
  "manifest_version": 3,
  "name": "PolyProf",
  "version": "0.3.0",
  "description": "Compare Cal Poly professors by rating, similar-student feedback, and your own learning-style preferences.",
  "action": {
    "default_title": "PolyProf",
    "default_popup": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://cmsweb.pscs.calpoly.edu/psc/*"],
  "content_scripts": [
    {
      "matches": ["https://cmsweb.pscs.calpoly.edu/psc/*"],
      "js": ["content-script.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
